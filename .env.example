# Local infrastructure only. Never use these values outside local development.
MIGRATION_DATABASE_URL=postgresql://siftloom_admin:siftloom_admin_local_only@localhost:5432/siftloom
AUTH_DATABASE_URL=postgresql://siftloom_auth:siftloom_auth_local_only@localhost:5432/siftloom
DATABASE_URL=postgresql://siftloom_web:siftloom_web_local_only@localhost:5432/siftloom
WORKER_DATABASE_URL=postgresql://siftloom_worker:siftloom_worker_local_only@localhost:5432/siftloom
TEST_DATABASE_URL=postgresql://siftloom_admin:siftloom_admin_local_only@localhost:5432/siftloom
TEST_AUTH_DATABASE_URL=postgresql://siftloom_auth:siftloom_auth_local_only@localhost:5432/siftloom
TEST_RUNTIME_DATABASE_URL=postgresql://siftloom_web:siftloom_web_local_only@localhost:5432/siftloom
TEST_WORKER_DATABASE_URL=postgresql://siftloom_worker:siftloom_worker_local_only@localhost:5432/siftloom

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_ENABLE_PASSWORD=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=

S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9090
S3_BUCKET=siftloom-local
S3_ACCESS_KEY_ID=local-s3mock
S3_SECRET_ACCESS_KEY=local-s3mock
S3_FORCE_PATH_STYLE=true

# M0 and automated tests use the deterministic fake. A live key is not required.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

NEXT_PUBLIC_APP_NAME=Siftloom
